{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ovrse.dev/schema/package-release.schema.json",
  "title": "OVRSE PackageRelease",
  "description": "Describes a specific package version, its dependencies, and which CVEs it fixes or contains",
  "type": "object",
  "required": ["apiVersion", "kind", "packageName", "version", "ecosystem", "fixesCves", "source"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "ovrse.dev/v1",
      "description": "OVRSE API version"
    },
    "kind": {
      "type": "string",
      "const": "PackageRelease",
      "description": "Document kind"
    },
    "packageName": {
      "type": "string",
      "description": "Package name as known to its package manager"
    },
    "version": {
      "type": "string",
      "description": "Specific version string"
    },
    "ecosystem": {
      "type": "string",
      "enum": ["apt", "yum", "dnf", "apk", "npm", "pypi", "maven", "go", "cargo", "nuget", "rubygems", "gem", "composer", "packagist", "hex", "pub"],
      "description": "Package ecosystem or manager"
    },
    "osFamily": {
      "type": "string",
      "description": "OS family (required for OS-level packages)"
    },
    "distribution": {
      "type": "string",
      "description": "Specific distribution"
    },
    "release": {
      "type": "string",
      "description": "Distribution release version"
    },
    "architecture": {
      "type": "string",
      "description": "CPU architecture"
    },
    "fixesCves": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CVE-[0-9]{4}-[0-9]+$"
      },
      "description": "CVE identifiers fixed when upgrading TO this version"
    },
    "hasCves": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CVE-[0-9]{4}-[0-9]+$"
      },
      "description": "CVE identifiers this version still contains (residual vulnerabilities)"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "description": "Direct dependencies for this package version (enables transitive shadow analysis)"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["name", "version", "ecosystem"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Dependency package name"
        },
        "version": {
          "type": "string",
          "description": "Resolved version (not version range)"
        },
        "ecosystem": {
          "type": "string",
          "description": "Dependency's ecosystem (usually same as parent)"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "reference", "importedAt"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["osv", "nvd", "csaf", "vendor-advisory", "emphere-intel", "community", "deps-dev", "lockfile"],
          "description": "Source type"
        },
        "reference": {
          "type": "string",
          "description": "URL or identifier for the source"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of import/creation"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
